# Copy this file to ".env" (same folder) and fill in your values.
# Get a Client ID at https://developer.spotify.com/dashboard → Create app.
# In the app's settings, add this exact Redirect URI:
#   http://127.0.0.1:5173/callback
# and tick "Web API" (and "Web Playback SDK" for Phase 5).

VITE_SPOTIFY_CLIENT_ID=your_client_id_here

# Optional. By default the redirect URI follows wherever the app is served:
#   dev:     http://127.0.0.1:5173/callback
#   Netlify: https://<your-site>.netlify.app/callback
# Add each one you use in the Spotify dashboard. Only set this to force a fixed value.
# VITE_SPOTIFY_REDIRECT_URI=
